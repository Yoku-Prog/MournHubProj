# Required. MONGODB_URI is also accepted, which is what Vercel's Atlas integration sets.
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/mournhub
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Required in production. Printed QR codes point here, so choose the final domain before printing any.
BASE_URL=https://example.com

# Required in production
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Local development only: the account registered with this email becomes the superadmin
# (without it, the first account does). Production ignores it: create the superadmin on
# the server with  npm run create-superadmin -- you@example.com "Your Name"
SUPERADMIN_EMAIL=

# Optional: shown on the landing and login pages. Contact links are hidden without it.
CONTACT_EMAIL=

# Optional
PORT=3000
NODE_ENV=development
# Reverse proxies in front of the app. Defaults to 1 in production, 0 otherwise.
# TRUST_PROXY=1
# Comma-separated DNS servers, for networks that can't resolve mongodb+srv records.
# DNS_SERVERS=8.8.8.8,8.8.4.4
