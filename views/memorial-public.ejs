<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title: memorial.fullName + " - MournHub" }) %>
  <%# Families share these pages by link and QR code, so they stay out of search results. %>
  <meta name="robots" content="noindex">
  <meta name="description" content="<%= memorial.lifeStory.slice(0, 160) %>">
  <meta property="og:type" content="website">
  <meta property="og:title" content="In loving memory of <%= memorial.fullName %>">
  <meta property="og:description" content="<%= memorial.lifeStory.slice(0, 160) %>">
  <meta property="og:url" content="<%= publicUrl %>">
  <% if (memorial.photoUrl) { %>
    <meta property="og:image" content="<%= memorial.photoUrl %>">
  <% } %>
  <script src="/js/memorial.js" defer></script>
</head>
<body data-slug="<%= memorial.slug %>">

  <div id="candleGlowOverlay" class="candle-glow-overlay"></div>

  <main class="memorial-public">
    <header>
      <% if (memorial.photoUrl) { %>
        <img src="<%= memorial.photoUrl %>" alt="<%= memorial.fullName %>" class="memorial-photo">
      <% } %>

      <p class="memorial-intro">In loving memory of</p>
      <h1 class="cut <%= memorial.fullName.length > 40 ? 'name-long' : '' %>"><%= memorial.fullName %></h1>

      <% if (memorial.birthDate || memorial.deathDate) { %>
        <p class="memorial-dates">
          <% if (memorial.birthDate) { %><%= formatDate(memorial.birthDate) %><% } %>
          <% if (memorial.birthDate && memorial.deathDate) { %>&ndash;<% } %>
          <% if (memorial.deathDate) { %><%= formatDate(memorial.deathDate) %><% } %>
        </p>
      <% } %>
    </header>

    <div class="memorial-sheet">
      <div class="candle-section">
        <button id="candleBtn" class="candle-btn">
          <svg class="candle-icon" viewBox="0 0 24 30" width="30" height="38" aria-hidden="true">
            <rect x="8" y="16" width="8" height="12" rx="1" fill="#ffffff" stroke="#5c6b60" stroke-width="1"/>
            <line x1="12" y1="16" x2="12" y2="10" stroke="#2e3b34" stroke-width="1.5" stroke-linecap="round"/>
            <g class="flame-group">
              <path class="flame-outer" d="M12 10 Q7 4 12 -3 Q17 4 12 10 Z" fill="#c98a2b"/>
              <path class="flame-inner" d="M12 8.5 Q9.5 4.5 12 0 Q14.5 4.5 12 8.5 Z" fill="#f0c060"/>
            </g>
          </svg>
          <span id="candleLabel">Light a candle</span>
        </button>
        <p class="candle-count" aria-live="polite"><span id="candleCount"><%= memorial.candleCount || 0 %></span> candle<span id="candlePlural"><%= (memorial.candleCount === 1) ? '' : 's' %></span> lit in remembrance</p>
      </div>

      <p class="memorial-story"><%= memorial.lifeStory %></p>

      <% if (memorial.photos && memorial.photos.length > 0) { %>
        <div class="memorial-gallery-preview" role="group" aria-label="Photos">
          <% memorial.photos.forEach(photo => { %>
            <a href="/memorial/<%= memorial.slug %>/photos/<%= photo._id %>" class="gallery-track-link" title="Open the full photo">
              <img src="<%= photo.url %>" alt="<%= photo.caption || 'Photo of ' + memorial.fullName %>" class="gallery-track-thumb" loading="lazy">
            </a>
          <% }) %>
        </div>
        <a href="/memorial/<%= memorial.slug %>/gallery" class="view-all-photos-link">View all photos</a>
      <% } %>

      <section class="guestbook-section">
        <h2 class="guestbook-heading">Messages of remembrance</h2>

        <form id="guestbookForm" class="guestbook-form">
          <input type="text" id="guestName" name="name" placeholder="Your name" aria-label="Your name" maxlength="60" required>
          <textarea id="guestMessage" name="message" placeholder="Share a memory or message..." aria-label="Your message" maxlength="500" rows="3" required></textarea>
          <button type="submit" id="guestbookSubmit">Leave a message</button>
          <p id="guestbookError" class="error" hidden></p>
        </form>

        <div id="guestbookList" class="guestbook-list">
          <% memorial.guestbookEntries.slice().reverse().forEach(entry => { %>
            <div class="guestbook-entry">
              <p class="guestbook-entry-message"><%= entry.message %></p>
              <p class="guestbook-entry-meta"><%= entry.name %>, <%= formatDate(entry.createdAt) %></p>
            </div>
          <% }) %>
        </div>
      </section>
    </div>

    <footer class="memorial-footer">Made with MournHub</footer>
  </main>
</body>
</html>
