<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title: "Log in - MournHub" }) %>
  <script src="/js/forms.js" defer></script>
</head>
<body>
  <div class="page">
    <header class="masthead">
      <a href="/" class="wordmark">MournHub</a>
    </header>

    <main class="split">
      <div class="split-lead">
        <h1 class="cut page-title">Welcome back</h1>
      </div>

      <div class="split-side">
        <div class="inlay panel">
          <% if (error) { %>
            <p class="error"><%= error %></p>
          <% } %>
          <% if (typeof notice !== 'undefined' && notice) { %>
            <p class="notice"><%= notice %></p>
          <% } %>

          <form method="POST" action="/login">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">

            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required>

            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="Enter your password" autocomplete="current-password" required>

            <button type="submit" class="gilded">Log in</button>
          </form>

          <p class="footnote">
            Don't have an account? <a href="/register">Register</a>
          </p>
          <p class="footnote">
            Forgot your password? Ask your administrator<% if (contactEmail) { %> at <a href="mailto:<%= contactEmail %>"><%= contactEmail %></a><% } %> for a reset link.
          </p>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
