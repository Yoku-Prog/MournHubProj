<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title: "Login - MournHub" }) %>
</head>
<body>
  <div class="container">
    <div class="hero">
      <div class="eyebrow">MournHub</div>
      <h1>Welcome back</h1>
    </div>
    <div class="divider"><span>🌿</span></div>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <% if (typeof notice !== 'undefined' && notice) { %>
      <p class="notice"><%= notice %></p>
    <% } %>

    <form method="POST" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">

      <label for="email">Email</label>
      <input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required>

      <label for="password">Password</label>
      <input type="password" id="password" name="password" placeholder="Enter your password" autocomplete="current-password" required>

      <button type="submit">Login</button>
    </form>

    <p class="auth-footnote">
      Don't have an account? <a href="/register">Register</a>
    </p>
    <p class="auth-footnote auth-footnote--tight">
      Forgot your password? Ask the superadmin<% if (contactEmail) { %> at <a href="mailto:<%= contactEmail %>"><%= contactEmail %></a><% } %> for a reset link.
    </p>
  </div>
</body>
</html>
