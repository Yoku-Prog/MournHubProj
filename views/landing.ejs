<!DOCTYPE html>
<html>
  <head>
    <title>MournHub - Honor a life, always within reach</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <div class="wide-container">
      <div class="hero" style="margin-top: 60px">
        <div class="eyebrow">MournHub</div>
        <h1>A lasting tribute, one scan away</h1>
        <p
          style="
            max-width: 480px;
            margin: 16px auto 0;
            color: #5c6b60;
            font-size: 16px;
          "
        >
          Create a lasting online memorial for a loved one, and let visitors
          reach it with a simple QR code — right at the place they're laid to
          rest.
        </p>
      </div>

      <div style="text-align: center; margin-bottom: 60px">
        <a href="/register" class="btn">Create a Memorial</a>
        <a href="/login" class="btn btn-secondary" style="margin-left: 12px"
          >Admin Login</a
        >
      </div>

      <div
        style="
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
          gap: 24px;
          margin-bottom: 60px;
        "
      >
        <div class="memorial-card" style="text-align: center">
          <h3>Write their story</h3>
          <p style="color: #5c6b60; font-size: 14px">
            Share their life, in your own words, kept safe and private until
            you're ready.
          </p>
        </div>

        <div class="memorial-card" style="text-align: center">
          <h3>Publish when ready</h3>
          <p style="color: #5c6b60; font-size: 14px">
            You control when the memorial goes public — no rush, no pressure.
          </p>
        </div>

        <div class="memorial-card" style="text-align: center">
          <h3>Scan to remember</h3>
          <p style="color: #5c6b60; font-size: 14px">
            Get a QR code linking straight to the tribute — place it at the
            gravesite.
          </p>
        </div>
      </div>

      <p
        style="
          text-align: center;
          color: #a9b8ac;
          font-size: 13px;
          margin-bottom: 40px;
        "
      >
        No login required for visitors — anyone can view a published memorial.
      </p>
    </div>
  </body>
</html>
