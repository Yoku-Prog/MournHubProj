<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head", { title: "MournHub - Honor a life, always within reach" }) %>
    <meta name="description" content="Create a lasting online memorial for a loved one, and let visitors reach it with a simple QR code." />
    <meta property="og:title" content="MournHub - A lasting tribute, one scan away" />
    <meta property="og:description" content="Create a lasting online memorial for a loved one, and let visitors reach it with a simple QR code." />
    <script src="/js/landing.js" defer></script>
  </head>
  <body class="landing-page">
    <div class="scroll-progress-bar" id="scrollProgress"></div>

    <nav class="landing-nav" id="landingNav">
      <div class="landing-nav-brand">MournHub</div>

      <button class="landing-nav-toggle" id="navToggle" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>

      <div class="landing-nav-links" id="navLinks">
        <a href="#how-it-works">How it works</a>
        <a href="#preview">Preview</a>
        <a href="#why">Why MournHub</a>
        <% if (contactEmail) { %>
        <a href="mailto:<%= contactEmail %>">Contact</a>
        <% } %>
        <a href="/login">Log in</a>
      </div>
    </nav>

    <!-- Hero -->
    <section class="landing-section landing-hero">
      <div class="landing-hero-art">
        <svg
          viewBox="0 0 200 140"
          width="180"
          height="126"
          role="img"
          aria-label="A candle glowing between two drooping leaves"
        >
          <ellipse
            cx="100"
            cy="128"
            rx="70"
            ry="6"
            fill="#DCD5BE"
            opacity="0.5"
          />

          <!-- Left leaf, drooping outward and down -->
          <path
            d="M85 128 C85 100 83 75 75 58 C69 46 55 38 35 40 C53 46 65 60 68 82 C70 100 76 118 85 128 Z"
            fill="#3E5C4C"
          />
          <path
            d="M75 58 C69 46 55 38 35 40"
            fill="none"
            stroke="#2E3B34"
            stroke-width="1"
          />

          <!-- Right leaf, mirrored -->
          <path
            d="M115 128 C115 100 117 75 125 58 C131 46 145 38 165 40 C147 46 135 60 132 82 C130 100 124 118 115 128 Z"
            fill="#3E5C4C"
          />
          <path
            d="M125 58 C131 46 145 38 165 40"
            fill="none"
            stroke="#2E3B34"
            stroke-width="1"
          />

          <!-- Candle, centered -->
          <ellipse cx="100" cy="115" rx="16" ry="8" fill="#EFE1C8" />
          <rect
            x="90"
            y="70"
            width="20"
            height="45"
            rx="4"
            fill="#FBF8F3"
            stroke="#DCD5BE"
            stroke-width="1"
          />
          <ellipse cx="100" cy="70" rx="10" ry="4" fill="#F6F3EC" />
          <path
            id="heroFlame"
            class="hero-flame"
            d="M100 62 Q96 52 100 44 Q104 52 100 62 Z"
            fill="#F0985C"
          />
          <path
            class="hero-flame-inner"
            d="M100 58 Q98 52 100 47 Q102 52 100 58 Z"
            fill="#FAD7A0"
          />
        </svg>
      </div>
      <h1>A lasting tribute,<br />one scan away</h1>
      <p class="landing-subtext">
        Create a lasting online memorial for a loved one, and let visitors reach
        it with a simple QR code — right at the place they're laid to rest.
      </p>
      <div class="landing-cta">
        <% if (contactEmail) { %>
        <a href="mailto:<%= contactEmail %>" class="cir-btn">
          Get in touch
          <svg class="cir-btn__arrow" viewBox="0 0 16 16" fill="none">
            <path
              d="M4 12L12 4M12 4H5M12 4V11"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
        <% } %>
        <a href="/register" class="cir-btn cir-btn--secondary">
          Request Admin Access
          <svg class="cir-btn__arrow" viewBox="0 0 16 16" fill="none">
            <path
              d="M4 12L12 4M12 4H5M12 4V11"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>
    </section>

    <!-- How it works: a real sequence, treated as one -->
    <section class="landing-section landing-sequence" id="how-it-works">
      <h2>From story to tribute, in three steps</h2>

      <ol class="sequence-list">
        <li class="sequence-item">
          <span class="sequence-number">01</span>
          <div>
            <h3>Write their story</h3>
            <p>
              Share their life, in your own words, kept safe and private until
              you're ready to publish.
            </p>
          </div>
        </li>
        <li class="sequence-item">
          <span class="sequence-number">02</span>
          <div>
            <h3>Publish when ready</h3>
            <p>
              You control when the memorial goes public — no rush, no pressure,
              no automation deciding for you.
            </p>
          </div>
        </li>
        <li class="sequence-item">
          <span class="sequence-number">03</span>
          <div>
            <h3>Scan to remember</h3>
            <p>
              Get a unique QR code linking straight to the tribute — place it at
              the gravesite for visitors to find.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <!-- Preview mockup -->
    <section class="landing-section" id="preview">
      <h2 class="landing-center-heading">What visitors see</h2>

      <div class="landing-preview">
        <div class="landing-preview-frame">
          <div class="preview-photo preview-photo--initials" aria-hidden="true">
            JD
          </div>
          <div class="memorial-eyebrow">In loving memory of</div>
          <h3 style="font-size: 22px; margin-bottom: 4px">Juan Dela Cruz</h3>
          <p
            style="
              color: #6b7563;
              font-size: 13px;
              font-style: italic;
              margin-bottom: 16px;
            "
          >
            1958 &mdash; 2024
          </p>
          <hr class="memorial-divider" style="margin-bottom: 16px" />

          <button class="preview-candle-btn" disabled>🕯 42 candles lit</button>

          <p
            style="
              color: #5c6b60;
              font-size: 14px;
              text-align: left;
              margin-top: 18px;
            "
          >
            He loved quiet mornings, his garden, and the sound of rain on the
            roof. A devoted father and friend to many...
          </p>

          <div class="preview-gallery">
            <span></span><span></span><span></span><span></span>
          </div>
        </div>
      </div>
    </section>

    <!-- Why MournHub: a plain comparison, not identical cards -->
    <section class="landing-section landing-definitions" id="why">
      <h2>Built for remembering, not scrolling</h2>

      <dl class="definition-list">
        <div class="definition-row">
          <dt>No login for visitors</dt>
          <dd>
            Anyone can view a published memorial instantly — no account, no app,
            just a scan.
          </dd>
        </div>
        <div class="definition-row">
          <dt>You stay in control</dt>
          <dd>
            Only approved admins can create or edit a memorial. Content stays
            private until published.
          </dd>
        </div>
        <div class="definition-row">
          <dt>A permanent link</dt>
          <dd>
            One QR code, one lasting page — a quiet place to return to, whenever
            you need to.
          </dd>
        </div>
      </dl>
    </section>

    <footer class="landing-footer">
      <p>MournHub &mdash; a space to remember.</p>
      <p class="landing-footer-admin"><a href="/login">Admin login</a></p>
    </footer>

    <button id="backToTop" class="back-to-top" aria-label="Back to top">
      ↑
    </button>

  </body>
</html>
