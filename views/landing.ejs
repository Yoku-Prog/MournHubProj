<!DOCTYPE html>
<html>
  <head>
    <title>MournHub - Honor a life, always within reach</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body class="landing-page">
    <div class="scroll-progress-bar" id="scrollProgress"></div>

    <nav class="landing-nav" id="landingNav">
      <div class="landing-nav-brand">MournHub</div>

      <button class="landing-nav-toggle" id="navToggle" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>

      <div class="landing-nav-links" id="navLinks">
        <a href="#how-it-works">How it works</a>
        <a href="#preview">Preview</a>
        <a href="#why">Why MournHub</a>
        <a href="mailto:youremail@example.com">Contact</a>
      </div>
    </nav>

    <!-- Hero -->
    <section class="landing-section landing-hero">
      <div class="landing-hero-art">
        <svg
          viewBox="0 0 200 140"
          width="180"
          height="126"
          role="img"
          aria-label="A leaf resting beside a glowing candle"
        >
          <ellipse cx="100" cy="128" rx="70" ry="6" fill="#DCD5BE" opacity="0.5" />
          <path d="M60 128 L60 70 Q60 55 75 50 Q65 65 68 80 Q70 100 60 128 Z" fill="#3E5C4C" />
          <path d="M60 70 Q60 55 75 50" fill="none" stroke="#2E3B34" stroke-width="1" />
          <ellipse cx="130" cy="115" rx="16" ry="8" fill="#EFE1C8" />
          <rect x="120" y="70" width="20" height="45" rx="4" fill="#FBF8F3" stroke="#DCD5BE" stroke-width="1" />
          <ellipse cx="130" cy="70" rx="10" ry="4" fill="#F6F3EC" />
          <path id="heroFlame" class="hero-flame" d="M130 62 Q126 52 130 44 Q134 52 130 62 Z" fill="#F0985C" />
          <path class="hero-flame-inner" d="M130 58 Q128 52 130 47 Q132 52 130 58 Z" fill="#FAD7A0" />
        </svg>
      </div>
      <h1>A lasting tribute,<br />one scan away</h1>
      <p class="landing-subtext">
        Create a lasting online memorial for a loved one, and let visitors reach
        it with a simple QR code — right at the place they're laid to rest.
      </p>
      <div class="landing-cta">
        <a href="mailto:youremail@example.com" class="cir-btn">
          Get in touch
          <svg class="cir-btn__arrow" viewBox="0 0 16 16" fill="none">
            <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/register" class="cir-btn cir-btn--secondary">
          Request Admin Access
          <svg class="cir-btn__arrow" viewBox="0 0 16 16" fill="none">
            <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </section>

    <!-- How it works: a real sequence, treated as one -->
    <section class="landing-section landing-sequence" id="how-it-works">
      <h2>From story to tribute, in three steps</h2>

      <ol class="sequence-list">
        <li class="sequence-item">
          <span class="sequence-number">01</span>
          <div>
            <h3>Write their story</h3>
            <p>Share their life, in your own words, kept safe and private until you're ready to publish.</p>
          </div>
        </li>
        <li class="sequence-item">
          <span class="sequence-number">02</span>
          <div>
            <h3>Publish when ready</h3>
            <p>You control when the memorial goes public — no rush, no pressure, no automation deciding for you.</p>
          </div>
        </li>
        <li class="sequence-item">
          <span class="sequence-number">03</span>
          <div>
            <h3>Scan to remember</h3>
            <p>Get a unique QR code linking straight to the tribute — place it at the gravesite for visitors to find.</p>
          </div>
        </li>
      </ol>
    </section>

    <!-- Preview mockup -->
    <section class="landing-section" id="preview">
      <h2 class="landing-center-heading">What visitors see</h2>

      <div class="landing-preview">
        <div class="landing-preview-frame">
          <svg width="28" height="28" viewBox="0 0 28 28" style="margin-bottom: 10px">
            <path d="M14 24 L14 12 Q14 6 20 5 Q16 10 17 16 Q18 20 14 24 Z" fill="#3E5C4C" />
          </svg>
          <div class="memorial-eyebrow">In loving memory of</div>
          <h3 style="font-size: 24px; margin-bottom: 4px">Juan Dela Cruz</h3>
          <p style="color: #6b7563; font-size: 13px; font-style: italic; margin-bottom: 16px">
            1958 &mdash; 2024
          </p>
          <hr class="memorial-divider" style="margin-bottom: 16px" />
          <p style="color: #5c6b60; font-size: 14px; text-align: left">
            He loved quiet mornings, his garden, and the sound of rain on the
            roof. A devoted father and friend to many...
          </p>
        </div>
      </div>
    </section>

    <!-- Why MournHub: a plain comparison, not identical cards -->
    <section class="landing-section landing-definitions" id="why">
      <h2>Built for remembering, not scrolling</h2>

      <dl class="definition-list">
        <div class="definition-row">
          <dt>No login for visitors</dt>
          <dd>Anyone can view a published memorial instantly — no account, no app, just a scan.</dd>
        </div>
        <div class="definition-row">
          <dt>You stay in control</dt>
          <dd>Only approved admins can create or edit a memorial. Content stays private until published.</dd>
        </div>
        <div class="definition-row">
          <dt>A permanent link</dt>
          <dd>One QR code, one lasting page — a quiet place to return to, whenever you need to.</dd>
        </div>
      </dl>
    </section>

    <footer class="landing-footer">
      <p>MournHub &mdash; a space to remember.</p>
    </footer>

    <button id="backToTop" class="back-to-top" aria-label="Back to top">↑</button>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        // Sticky header shadow on scroll
        const nav = document.getElementById("landingNav");
        window.addEventListener("scroll", () => {
          if (window.scrollY > 10) {
            nav.classList.add("scrolled");
          } else {
            nav.classList.remove("scrolled");
          }
        });

        // Scroll progress bar
        const progressBar = document.getElementById("scrollProgress");
        window.addEventListener("scroll", () => {
          const scrollTop = window.scrollY;
          const docHeight = document.documentElement.scrollHeight - window.innerHeight;
          const percent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
          progressBar.style.width = percent + "%";
        });

        // Mobile menu toggle
        const navToggle = document.getElementById("navToggle");
        const navLinks = document.getElementById("navLinks");
        navToggle.addEventListener("click", () => {
          navLinks.classList.toggle("is-open");
          navToggle.classList.toggle("is-active");
        });
        navLinks.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            navLinks.classList.remove("is-open");
            navToggle.classList.remove("is-active");
          });
        });

        // Back to top button
        const backToTop = document.getElementById("backToTop");
        window.addEventListener("scroll", () => {
          if (window.scrollY > 400) {
            backToTop.classList.add("is-visible");
          } else {
            backToTop.classList.remove("is-visible");
          }
        });
        backToTop.addEventListener("click", () => {
          window.scrollTo({ top: 0, behavior: "smooth" });
        });

        // The one deliberate motion moment: hero flame flickers to life on load
        const flame = document.getElementById("heroFlame");
        setTimeout(() => flame.classList.add("is-lit"), 400);
      });
    </script>
  </body>
</html>