<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title: title + " - MournHub" }) %>
  <meta name="robots" content="noindex">
</head>
<body>
  <div class="page">
    <header class="masthead">
      <a href="/" class="wordmark">MournHub</a>
    </header>

    <main class="split">
      <div class="split-lead">
        <h1 class="cut page-title"><%= title %></h1>
        <p><%= message %></p>
        <a href="<%= locals.returnHref || '/' %>" class="gilded">Return to MournHub</a>
      </div>
    </main>
  </div>
</body>
</html>
