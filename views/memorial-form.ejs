<% const isEdit = Boolean(memorial && memorial._id); -%>
<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("partials/head", { title: (isEdit ? "Edit" : "Create") + " Memorial - MournHub" }) %>
  <script src="/js/forms.js" defer></script>
</head>
<body>
  <div class="page-form">
    <div class="page-form-inner">
      <h2><%= isEdit ? 'Edit Memorial' : 'Create New Memorial' %></h2>

      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <% if (isEdit && memorial.photos && memorial.photos.length > 0) { %>
        <label>Current Gallery Photos:</label>
        <div class="gallery-preview-grid">
          <% memorial.photos.forEach(photo => { %>
            <div class="gallery-preview-item">
              <img src="<%= photo.url %>" alt="<%= photo.caption || 'Gallery photo' %>">
              <form action="/memorials/<%= memorial._id %>/photos/<%= photo._id %>/delete" method="POST" class="gallery-remove-form" data-confirm="Remove this photo?">
                <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                <button type="submit" class="gallery-remove-btn" aria-label="Remove photo">✕</button>
              </form>
              <form action="/memorials/<%= memorial._id %>/photos/<%= photo._id %>/caption" method="POST" class="gallery-caption-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                <input type="text" name="caption" value="<%= photo.caption || '' %>" placeholder="Add a caption" aria-label="Photo caption" maxlength="200">
                <button type="submit">Save</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } %>

      <form method="POST" action="<%= isEdit ? '/memorials/' + memorial._id + '/edit' : '/memorials/new' %>" enctype="multipart/form-data" class="memorial-form-card" data-saving-label="Saving…">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">

        <label for="fullName">Full Name:</label>
        <input type="text" id="fullName" name="fullName" value="<%= memorial ? memorial.fullName : '' %>" maxlength="120" required>

        <label for="photo">Photo (optional):</label>
        <% if (memorial && memorial.photoUrl) { %>
          <div class="current-photo-preview">
            <img src="<%= memorial.photoUrl %>" alt="Current photo">
            <p>Current photo — upload a new one to replace it</p>
          </div>
        <% } %>
        <input type="file" id="photo" name="photo" accept="image/jpeg,image/png,image/webp">

        <label for="galleryPhotos">Add Gallery Photos (optional, up to 10 at a time):</label>
        <input type="file" id="galleryPhotos" name="galleryPhotos" accept="image/jpeg,image/png,image/webp" multiple>

        <label for="birthDate">Birth Date:</label>
        <input type="date" id="birthDate" name="birthDate" value="<%= memorial ? formatDateInput(memorial.birthDate) : '' %>">

        <label for="deathDate">Death Date:</label>
        <input type="date" id="deathDate" name="deathDate" value="<%= memorial ? formatDateInput(memorial.deathDate) : '' %>">

        <label for="lifeStory">Life Story:</label>
        <textarea id="lifeStory" name="lifeStory" rows="10" required><%= memorial ? memorial.lifeStory : '' %></textarea>

        <button type="submit"><%= isEdit ? 'Save Changes' : 'Create Memorial' %></button>
      </form>

      <% if (isEdit && memorial.guestbookEntries && memorial.guestbookEntries.length > 0) { %>
        <div class="guestbook-moderation">
          <h3>Guestbook messages (<%= memorial.guestbookEntries.length %>)</h3>
          <% memorial.guestbookEntries.slice().reverse().forEach(entry => { %>
            <div class="memorial-card guestbook-moderation-entry">
              <p class="guestbook-moderation-message"><%= entry.message %></p>
              <p class="guestbook-moderation-meta">&mdash; <%= entry.name %>, <%= new Date(entry.createdAt).toDateString() %></p>
              <form action="/memorials/<%= memorial._id %>/guestbook/<%= entry._id %>/delete" method="POST" data-confirm="Delete this message?">
                <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                <button type="submit" class="btn-danger">Remove</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } %>

      <a class="back-to-dashboard" href="/dashboard">← Back to Dashboard</a>
    </div>
  </div>
</body>
</html>
