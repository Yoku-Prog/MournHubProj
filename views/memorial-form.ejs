<!DOCTYPE html>
<html>
<head>
  <title><%= memorial ? 'Edit' : 'Create' %> Memorial - MournHub</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600&family=Inter:wght@400;500&display=swap" rel="stylesheet">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="page-form">
    <div class="page-form-inner">
      <h2><%= memorial ? 'Edit Memorial' : 'Create New Memorial' %></h2>

      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>

      <form method="POST" action="<%= memorial ? '/memorials/' + memorial._id + '/edit' : '/memorials/new' %>" enctype="multipart/form-data">
        <label>Full Name:</label>
        <input type="text" name="fullName" value="<%= memorial ? memorial.fullName : '' %>" required>

        <label>Photo (optional):</label>
        <% if (memorial && memorial.photoUrl) { %>
          <div class="current-photo-preview">
            <img src="<%= memorial.photoUrl %>" alt="Current photo">
            <p>Current photo — upload a new one to replace it</p>
          </div>
        <% } %>
        <input type="file" name="photo" accept="image/jpeg,image/png,image/webp">

        <label>Additional Gallery Photos (optional, up to 10):</label>
        <% if (memorial && memorial.photos && memorial.photos.length > 0) { %>
          <div class="gallery-preview-grid">
            <% memorial.photos.forEach(photo => { %>
              <div class="gallery-preview-item">
                <img src="<%= photo %>" alt="Gallery photo">
                <form action="/memorials/<%= memorial._id %>/photos/<%= encodeURIComponent(photo) %>/delete" method="POST" onsubmit="return confirm('Remove this photo?');">
                  <button type="submit" class="gallery-remove-btn">✕</button>
                </form>
              </div>
            <% }) %>
          </div>
        <% } %>
        <input type="file" name="galleryPhotos" accept="image/jpeg,image/png,image/webp" multiple>

        <label>Birth Date:</label>
        <input type="date" name="birthDate" value="<%= memorial && memorial.birthDate ? memorial.birthDate.toISOString().split('T')[0] : '' %>">

        <label>Death Date:</label>
        <input type="date" name="deathDate" value="<%= memorial && memorial.deathDate ? memorial.deathDate.toISOString().split('T')[0] : '' %>">

        <label>Life Story:</label>
        <textarea name="lifeStory" rows="10" required><%= memorial ? memorial.lifeStory : '' %></textarea>

        <button type="submit"><%= memorial ? 'Save Changes' : 'Create Memorial' %></button>
      </form>

      <% if (memorial && memorial.guestbookEntries && memorial.guestbookEntries.length > 0) { %>
        <div class="guestbook-moderation">
          <h3>Guestbook messages (<%= memorial.guestbookEntries.length %>)</h3>
          <% memorial.guestbookEntries.slice().reverse().forEach(entry => { %>
            <div class="memorial-card guestbook-moderation-entry">
              <p class="guestbook-moderation-message"><%= entry.message %></p>
              <p class="guestbook-moderation-meta">&mdash; <%= entry.name %>, <%= new Date(entry.createdAt).toDateString() %></p>
              <form action="/memorials/<%= memorial._id %>/guestbook/<%= entry._id %>/delete" method="POST" onsubmit="return confirm('Delete this message?');">
                <button type="submit" class="btn-danger">Remove</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } %>

      <a class="back-to-dashboard" href="/dashboard">← Back to Dashboard</a>
    </div>
  </div>
</body>
</html>